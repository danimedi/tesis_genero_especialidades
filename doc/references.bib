@article{sepulveda-vildosolaTrendsMedicalSpecialization2022,
  title = {Trends in {{Medical Specialization}} and {{Employability}} in {{Mexico According}} to {{Gender}}},
  author = {{Sep{\'u}lveda-Vild{\'o}sola}, Ana Carolina and Gonz{\'a}lez, Horacio-M{\'a}rquez and {L{\'o}pez-Sep{\'u}lveda}, Mar{\'i}a Fernanda and {Mart{\'i}nez-Escobar}, Cecilia Beatriz},
