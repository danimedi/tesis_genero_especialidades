@article{levinsonWhenMostDoctors2004,
  title = {When {{Most Doctors Are Women}}: {{What Lies Ahead}}?},
  shorttitle = {When {{Most Doctors Are Women}}},
  author = {Levinson, Wendy and Lurie, Nicole},
  year = {2004},
